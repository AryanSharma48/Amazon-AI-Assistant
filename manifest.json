{
    "manifest_version" : 3,
    "name" : "SWAN",
    "version" : "0.3.0",
    "description" : "Let SWAN glide effortlessly through the messy reviews to build you a perfect summary of the product.",
    "action": {
        "default_popup" : "pop-up/popup.html"
    },
    "icons":{
        "32" : "assets/icon-32.png",
        "48" : "assets/icon-48.png"
    },
    "background" : {
        "service_worker" : "background.js"
    },
    "permissions":[
        "activeTab",
        "sidePanel",
        "scripting",
        "tabs",
        "storage"
    ],
    
    "host_permissions": [
        "http://localhost:8080/*",
        "*://*.amazon.com/*",
        "*://*.amazon.in/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.au/*"
    ],
    "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*", 
        "*://*.amazon.in/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.au/*"
      ],
      "js": ["content.js"]
    }
  ]
}